APP_NAME=Lamoid
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://alpaca.local:8080
APP_PORT=8080

VIRTUAL_HOST=alpaca.local

#DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=alpaca
DB_USERNAME=alpaca
DB_PASSWORD=
FORWARD_DB_PORT=3369

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
SESSION_DRIVER=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

FILE_DOWNLOAD_SECRET=

LOG_CHANNEL=stack

# supervisor/queue
APP_ROOT=/app
QUEUE_DRIVER=redis
QUEUE_CONNECTION=redis   # this is set to `sync` in the .env file Laravel provides
QUEUE_OPTIONS="--sleep=3 --tries=3"
NUM_PROCS=4

# Optional super user created by the migrations (leave empty to skip)
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
